{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Comms",
  "version": "0.1.0",
  "identifier": "ca.mitchhentges.comms",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Comms",
        "width": 880,
        "height": 680,
        "minWidth": 400,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "resources/logo-32.png",
      "resources/logo-256.png",
      "resources/logo.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "comms"
        ]
      }
    }
  }
}
